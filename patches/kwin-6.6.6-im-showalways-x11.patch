+// 09-27 pc-keyd: 见 init() 注释。X11 窗口激活 → 原生 setActive/show；其余窗口走原生刷新。
+void InputMethod::slotWindowActivatedShowAlways(Window *window)
+{
+    if (!m_enabled) {
+        return;
+    }
+    if (qobject_cast<X11Window *>(window)) {
+        setTrackedWindow(window);
+        setActive(true);
+        show();
+    } else {
+        refreshActive();
+    }
+}
